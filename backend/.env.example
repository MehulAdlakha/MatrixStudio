# Matrix Studio Backend Configuration
PORT=5000
HOST=0.0.0.0

# Frontend development URL(s) for CORS. Can be comma-separated if accessing from mobile IP
# Example: http://localhost:3000,http://192.168.1.150:3000
FRONTEND_URL=http://localhost:3000

# Device timeout threshold in milliseconds (device marked offline if no heartbeat)
DEVICE_TIMEOUT_MS=3500
